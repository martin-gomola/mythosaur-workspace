MW_PROFILE=readonly
MW_MCP_PORT=8066
MW_MCP_CLIENT_URL=http://127.0.0.1:8066/mcp

# Power-mode capabilities
MW_GOOGLE_CALENDAR_WRITE_ENABLED=true
MW_GOOGLE_GMAIL_SEND_ENABLED=true
MW_GOOGLE_DRIVE_WRITE_ENABLED=true
MW_GOOGLE_SHEETS_WRITE_ENABLED=true
MW_GOOGLE_DOCS_WRITE_ENABLED=true
MW_GOOGLE_PHOTOS_READ_ENABLED=true
MW_GOOGLE_PHOTOS_WRITE_ENABLED=true

# Optional Google Maps API access
MW_GOOGLE_MAPS_API_KEY=
